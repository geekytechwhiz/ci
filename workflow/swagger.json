{
  "swagger": "2.0",
  "info": {
    "title": "Workflow Service API",
    "version": "1.0.0",
    "description": "Workflow Service — health, workflow templates, care-plan mappings, WR-08b runtime commands (workflows, steps, checklists), WR-08c runtime queries."
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "operationId": "healthCheck",
        "responses": {
          "200": {
            "description": "Service is healthy"
          }
        }
      }
    },
    "/v1/platform/workflow-templates/{templateId}/history": {
      "get": {
        "summary": "List platform workflow template history",
        "operationId": "listPlatformWorkflowTemplateHistory",
        "parameters": [
          {
            "name": "templateId",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "default": 50
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated append-only template history (oldest first)",
            "schema": {
              "$ref": "#/definitions/WorkflowTemplateHistoryListResponse"
            }
          },
          "404": {
            "description": "Template not found"
          }
        }
      }
    }
  },
  "definitions": {
    "WorkflowAssigneeRef": {
      "type": "object",
      "required": ["assigneeType", "assigneeId"],
      "additionalProperties": false,
      "properties": {
        "assigneeType": {
          "type": "string",
          "enum": ["user", "role", "team"]
        },
        "assigneeId": {
          "type": "string"
        }
      }
    },
    "CreateWorkflowRequest": {
      "type": "object",
      "required": ["workflowType", "patientId", "carePlanId", "carePlanTemplateId"],
      "additionalProperties": false,
      "properties": {
        "workflowType": {
          "type": "string",
          "enum": ["PATIENT_ONBOARDING", "FORMAL_REVIEW", "CLOSURE_REVIEW"]
        },
        "patientId": { "type": "string" },
        "carePlanId": { "type": "string" },
        "contextKey": { "type": "string" },
        "carePlanTemplateId": {
          "type": "string",
          "description": "Care plan template id for stage → workflow template mapping."
        },
        "workflowStage": {
          "type": "string",
          "enum": ["PATIENT_ONBOARDING", "FORMAL_REVIEW", "CLOSURE_REVIEW"],
          "description": "Workflow stage for care-plan mapping lookup. Defaults to workflowType when omitted."
        },
        "assignee": { "$ref": "#/definitions/WorkflowAssigneeRef" },
        "dueAt": { "type": "string", "format": "date-time" },
        "autoStart": { "type": "boolean", "default": true },
        "correlationId": { "type": "string" }
      },
      "example": {
        "workflowType": "PATIENT_ONBOARDING",
        "patientId": "pat-1",
        "carePlanId": "cp-1",
        "carePlanTemplateId": "cpt-1",
        "workflowStage": "PATIENT_ONBOARDING",
        "contextKey": "default",
        "autoStart": true
      }
    },
    "WorkflowOccRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recordVersion": {
          "type": "integer",
          "minimum": 1,
          "description": "OCC alternative to If-Match"
        },
        "reason": { "type": "string" }
      }
    },
    "AssignWorkflowRequest": {
      "type": "object",
      "required": ["assigneeType", "assigneeId"],
      "additionalProperties": false,
      "properties": {
        "assigneeType": {
          "type": "string",
          "enum": ["user", "role", "team"]
        },
        "assigneeId": { "type": "string" },
        "reason": { "type": "string" },
        "recordVersion": { "type": "integer", "minimum": 1 }
      }
    },
    "ReasonWorkflowRequest": {
      "type": "object",
      "required": ["reason"],
      "additionalProperties": false,
      "properties": {
        "reason": { "type": "string" },
        "recordVersion": { "type": "integer", "minimum": 1 }
      }
    },
    "CompleteWorkflowRequest": {
      "type": "object",
      "required": ["outcome"],
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "type": "string",
          "enum": ["completed"],
          "description": "Lifecycle outcome for Care Plan Runtime (WF-FR-024). Successful complete must be completed."
        },
        "finalNote": { "type": "string" },
        "recordVersion": { "type": "integer", "minimum": 1 }
      }
    },
    "CancelWorkflowRequest": {
      "type": "object",
      "required": ["reason"],
      "additionalProperties": false,
      "properties": {
        "reason": { "type": "string" },
        "recordVersion": { "type": "integer", "minimum": 1 }
      }
    },
    "StepActionRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reason": { "type": "string" },
        "note": { "type": "string" },
        "recordVersion": { "type": "integer", "minimum": 1 }
      }
    },
    "StepActionWithReasonRequest": {
      "type": "object",
      "required": ["reason"],
      "additionalProperties": false,
      "properties": {
        "reason": { "type": "string" },
        "note": { "type": "string" },
        "recordVersion": { "type": "integer", "minimum": 1 }
      }
    },
    "AssignStepRequest": {
      "type": "object",
      "required": ["assigneeType", "assigneeId"],
      "additionalProperties": false,
      "properties": {
        "assigneeType": {
          "type": "string",
          "enum": ["user", "role", "team"]
        },
        "assigneeId": { "type": "string" },
        "reason": { "type": "string" },
        "recordVersion": { "type": "integer", "minimum": 1 }
      }
    },
    "AddWorkflowStepRequest": {
      "type": "object",
      "required": ["stepId", "name"],
      "additionalProperties": false,
      "properties": {
        "stepId": { "type": "string" },
        "name": { "type": "string" },
        "requirement": {
          "type": "string",
          "enum": ["mandatory", "optional", "conditional"]
        },
        "allowSkip": { "type": "boolean" },
        "allowDefer": { "type": "boolean" },
        "condition": { "type": "string", "nullable": true },
        "assigneeType": {
          "type": "string",
          "enum": ["user", "role", "team"]
        },
        "assigneeId": { "type": "string" },
        "sortOrder": { "type": "integer", "minimum": 1 },
        "reason": { "type": "string" },
        "recordVersion": { "type": "integer", "minimum": 1 }
      }
    },
    "AddStepChecklistRequest": {
      "type": "object",
      "required": ["checklistId", "itemName"],
      "additionalProperties": false,
      "properties": {
        "checklistId": { "type": "string" },
        "itemName": { "type": "string" },
        "instruction": { "type": "string" },
        "required": { "type": "boolean" },
        "allowSkip": { "type": "boolean" },
        "allowDefer": { "type": "boolean" },
        "blocksStepCompletion": { "type": "boolean" },
        "sortOrder": { "type": "integer", "minimum": 1 },
        "reason": { "type": "string" },
        "recordVersion": { "type": "integer", "minimum": 1 }
      }
    },
    "ChecklistActionRequest": {
      "type": "object",
      "additionalProperties": false,
      "description": "Checklist action body for start, complete, resume, skip, and defer. reason is optional.",
      "properties": {
        "reason": { "type": "string" },
        "note": { "type": "string" },
        "recordVersion": { "type": "integer", "minimum": 1 }
      }
    },
    "ChecklistActionWithReasonRequest": {
      "type": "object",
      "required": ["reason"],
      "additionalProperties": false,
      "description": "Checklist action body for block and cancel. reason is required.",
      "properties": {
        "reason": { "type": "string" },
        "note": { "type": "string" },
        "recordVersion": { "type": "integer", "minimum": 1 }
      }
    },
    "AssignChecklistRequest": {
      "type": "object",
      "required": ["assigneeType", "assigneeId"],
      "additionalProperties": false,
      "properties": {
        "assigneeType": {
          "type": "string",
          "enum": ["user", "role", "team"]
        },
        "assigneeId": { "type": "string" },
        "reason": { "type": "string" },
        "recordVersion": { "type": "integer", "minimum": 1 }
      }
    },
    "WorkflowChecklistResponse": {
      "type": "object",
      "properties": {
        "organizationId": { "type": "string" },
        "workflowId": { "type": "string" },
        "stepId": { "type": "string" },
        "checklistId": { "type": "string" },
        "itemName": { "type": "string" },
        "instruction": { "type": "string" },
        "required": { "type": "boolean" },
        "allowSkip": { "type": "boolean" },
        "allowDefer": { "type": "boolean" },
        "blocksStepCompletion": { "type": "boolean" },
        "linkedAction": {
          "type": "object",
          "required": ["actionCode"],
          "additionalProperties": false,
          "properties": {
            "actionCode": { "type": "string" }
          }
        },
        "linkedObject": {
          "type": "object",
          "required": ["objectType", "objectId"],
          "additionalProperties": false,
          "properties": {
            "objectType": { "type": "string" },
            "objectId": { "type": "string" }
          }
        },
        "checklistStatus": { "type": "string" },
        "active": { "type": "boolean" },
        "sortOrder": { "type": "integer" },
        "assigneeType": { "type": "string" },
        "assigneeId": { "type": "string" },
        "assigneeOverride": { "$ref": "#/definitions/WorkflowAssigneeRef" },
        "effectiveAssignee": {
          "type": "object",
          "properties": {
            "assigneeType": { "type": "string" },
            "assigneeId": { "type": "string" },
            "source": { "type": "string" }
          }
        },
        "reason": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "recordVersion": { "type": "integer" }
      }
    },
    "WorkflowChecklistListResponse": {
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "items": { "$ref": "#/definitions/WorkflowChecklistResponse" }
        }
      }
    },
    "WorkflowInstanceResponse": {
      "type": "object",
      "properties": {
        "organizationId": { "type": "string" },
        "workflowId": { "type": "string" },
        "workflowType": { "type": "string" },
        "definitionVersion": { "type": "string" },
        "patientId": { "type": "string" },
        "carePlanId": { "type": "string" },
        "contextKey": { "type": "string" },
        "workflowStatus": { "type": "string" },
        "dueAt": { "type": "string" },
        "assigneeType": { "type": "string" },
        "assigneeId": { "type": "string" },
        "outcome": { "type": "string" },
        "correlationId": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "recordVersion": { "type": "integer" }
      }
    },
    "WorkflowStepResponse": {
      "type": "object",
      "properties": {
        "organizationId": { "type": "string" },
        "workflowId": { "type": "string" },
        "stepId": { "type": "string" },
        "name": { "type": "string" },
        "instructions": {
          "type": "string",
          "description": "Copied from the published template at workflow create time."
        },
        "stepStatus": { "type": "string" },
        "sortOrder": { "type": "integer" },
        "reason": { "type": "string" },
        "linkedAction": {
          "type": "object",
          "required": ["actionCode"],
          "additionalProperties": false,
          "properties": {
            "actionCode": { "type": "string" }
          }
        },
        "recordVersion": { "type": "integer" }
      }
    },
    "WorkflowNoteResponse": {
      "type": "object",
      "properties": {
        "organizationId": { "type": "string" },
        "workflowId": { "type": "string" },
        "noteId": { "type": "string" },
        "text": { "type": "string" },
        "stepId": { "type": "string" },
        "createdAt": { "type": "string" },
        "createdBy": { "type": "string" }
      }
    },
    "WorkflowEvidenceResponse": {
      "type": "object",
      "properties": {
        "organizationId": { "type": "string" },
        "workflowId": { "type": "string" },
        "evidenceId": { "type": "string" },
        "stepId": { "type": "string" },
        "refType": { "type": "string" },
        "refId": { "type": "string" },
        "label": { "type": "string" },
        "addedAt": { "type": "string" }
      }
    },
    "WorkflowAuditResponse": {
      "type": "object",
      "properties": {
        "organizationId": { "type": "string" },
        "workflowId": { "type": "string" },
        "auditId": { "type": "string" },
        "action": { "type": "string" },
        "timestamp": { "type": "string" },
        "reason": { "type": "string" },
        "stepId": { "type": "string" }
      }
    },
    "PaginatedWorkflowListResponse": {
      "type": "object",
      "required": ["items", "nextCursor"],
      "properties": {
        "items": {
          "type": "array",
          "items": { "$ref": "#/definitions/WorkflowInstanceResponse" }
        },
        "nextCursor": { "type": "string", "x-nullable": true }
      }
    },
    "DashboardQueueRowResponse": {
      "type": "object",
      "properties": {
        "workflowId": { "type": "string" },
        "workflowType": { "type": "string" },
        "patientId": { "type": "string" },
        "carePlanId": { "type": "string" },
        "workflowStatus": { "type": "string" },
        "dueAt": { "type": "string" },
        "assigneeType": { "type": "string" },
        "assigneeId": { "type": "string" }
      }
    },
    "CompletionReadinessResponse": {
      "type": "object",
      "properties": {
        "ready": { "type": "boolean" },
        "missingRequirements": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "stepId": { "type": "string" },
              "reason": { "type": "string" }
            }
          }
        },
        "blockingIssues": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": { "type": "string" },
              "message": { "type": "string" }
            }
          }
        },
        "completionSummary": { "type": "object" }
      }
    },
    "WorkflowWorkbenchChecklist": {
      "type": "object",
      "required": [
        "checklistId",
        "itemName",
        "required",
        "allowSkip",
        "allowDefer",
        "checklistStatus",
        "recordVersion",
        "sortOrder"
      ],
      "properties": {
        "checklistId": { "type": "string" },
        "itemName": { "type": "string" },
        "instruction": { "type": "string" },
        "required": { "type": "boolean" },
        "allowSkip": { "type": "boolean" },
        "allowDefer": { "type": "boolean" },
        "blocksStepCompletion": { "type": "boolean" },
        "linkedAction": {
          "type": "object",
          "required": ["actionCode"],
          "additionalProperties": false,
          "properties": {
            "actionCode": { "type": "string" }
          }
        },
        "checklistStatus": { "type": "string" },
        "recordVersion": { "type": "integer", "minimum": 1 },
        "reason": {
          "type": "string",
          "description": "Set by skip/defer/block/cancel (and other reason-bearing actions)"
        },
        "sortOrder": { "type": "integer" },
        "assigneeType": {
          "type": "string",
          "description": "Optional. Effective checklist assignee (runtime checklist → override → parent step)."
        },
        "assigneeId": {
          "type": "string",
          "description": "Optional. Role/user/team id for the effective checklist assignee."
        }
      }
    },
    "WorkflowStepTracker": {
      "type": "object",
      "required": ["stepId", "name", "stepStatus", "sortOrder", "checklists"],
      "properties": {
        "stepId": { "type": "string" },
        "name": { "type": "string" },
        "instructions": { "type": "string" },
        "stepStatus": { "type": "string" },
        "sortOrder": { "type": "integer" },
        "requirement": { "type": "string" },
        "allowSkip": { "type": "boolean" },
        "allowDefer": { "type": "boolean" },
        "assigneeType": {
          "type": "string",
          "description": "Optional. Present when the runtime step has an assignee (from template defaultAssignee or later assignment)."
        },
        "assigneeId": {
          "type": "string",
          "description": "Optional. Role/user/team id (e.g. careCoordinator). Clients map to display labels."
        },
        "linkedAction": {
          "type": "object",
          "required": ["actionCode"],
          "additionalProperties": false,
          "properties": {
            "actionCode": { "type": "string" }
          }
        },
        "checklists": {
          "type": "array",
          "items": { "$ref": "#/definitions/WorkflowWorkbenchChecklist" }
        }
      }
    },
    "WorkflowWorkbenchResponse": {
      "type": "object",
      "required": [
        "workflow",
        "banner",
        "stepsTracker",
        "blockers",
        "missingRequirements",
        "progress",
        "evidence",
        "ctas"
      ],
      "properties": {
        "workflow": { "$ref": "#/definitions/WorkflowInstanceResponse" },
        "banner": {
          "type": "object",
          "properties": {
            "workflowStatus": { "type": "string" },
            "workflowType": { "type": "string" },
            "dueAt": { "type": "string", "format": "date-time" }
          }
        },
        "stepsTracker": {
          "type": "array",
          "items": { "$ref": "#/definitions/WorkflowStepTracker" }
        },
        "blockers": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": { "type": "string" },
              "message": { "type": "string" }
            }
          }
        },
        "missingRequirements": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "stepId": { "type": "string" },
              "reason": { "type": "string" },
              "checklistId": { "type": "string" }
            }
          }
        },
        "progress": {
          "type": "object",
          "properties": {
            "completed": { "type": "integer" },
            "totalApplicable": { "type": "integer" }
          }
        },
        "evidence": { "type": "array", "items": { "type": "object" } },
        "ctas": {
          "type": "object",
          "properties": {
            "canComplete": { "type": "boolean" },
            "canResume": { "type": "boolean" }
          }
        }
      }
    },
    "WorkflowTemplateChecklist": {
      "type": "object",
      "required": [
        "checklistId",
        "itemName",
        "required",
        "allowSkip",
        "allowDefer",
        "active",
        "sortOrder"
      ],
      "additionalProperties": false,
      "properties": {
        "checklistId": { "type": "string" },
        "itemName": { "type": "string" },
        "instruction": { "type": "string" },
        "required": { "type": "boolean" },
        "allowSkip": { "type": "boolean" },
        "allowDefer": { "type": "boolean" },
        "blocksStepCompletion": { "type": "boolean" },
        "linkedAction": {
          "type": "object",
          "required": ["actionCode"],
          "additionalProperties": false,
          "properties": {
            "actionCode": { "type": "string" }
          }
        },
        "linkedObject": {
          "type": "object",
          "required": ["objectType", "objectId"],
          "additionalProperties": false,
          "properties": {
            "objectType": { "type": "string" },
            "objectId": { "type": "string" }
          }
        },
        "assigneeOverride": { "$ref": "#/definitions/WorkflowAssigneeRef" },
        "active": { "type": "boolean" },
        "sortOrder": { "type": "number" }
      }
    },
    "WorkflowTemplateStep": {
      "type": "object",
      "required": [
        "stepId",
        "name",
        "requirement",
        "allowSkip",
        "allowDefer",
        "sortOrder"
      ],
      "additionalProperties": false,
      "properties": {
        "stepId": { "type": "string" },
        "name": { "type": "string" },
        "instructions": { "type": "string" },
        "requirement": {
          "type": "string",
          "enum": ["mandatory", "optional", "conditional"]
        },
        "allowSkip": { "type": "boolean" },
        "allowDefer": { "type": "boolean" },
        "condition": { "type": "string", "x-nullable": true },
        "sortOrder": { "type": "number" },
        "defaultAssignee": { "$ref": "#/definitions/WorkflowAssigneeRef" },
        "linkedAction": {
          "type": "object",
          "required": ["actionCode"],
          "additionalProperties": false,
          "properties": {
            "actionCode": { "type": "string" }
          }
        },
        "checklists": {
          "type": "array",
          "items": { "$ref": "#/definitions/WorkflowTemplateChecklist" }
        }
      }
    },
    "CreateWorkflowTemplateRequest": {
      "type": "object",
      "required": ["templateName", "workflowType", "workflowStage", "steps"],
      "additionalProperties": false,
      "properties": {
        "templateId": { "type": "string" },
        "templateName": { "type": "string" },
        "workflowType": {
          "type": "string",
          "enum": ["PATIENT_ONBOARDING", "FORMAL_REVIEW", "CLOSURE_REVIEW"]
        },
        "workflowStage": {
          "type": "string",
          "enum": ["PATIENT_ONBOARDING", "FORMAL_REVIEW", "CLOSURE_REVIEW"]
        },
        "description": { "type": "string" },
        "program": { "type": "string" },
        "condition": { "type": "string" },
        "basedOn": { "type": "string" },
        "category": { "$ref": "#/definitions/MetadataValueCode" },
        "shareScope": { "$ref": "#/definitions/MetadataValueCode" },
        "language": { "$ref": "#/definitions/MetadataValueCode" },
        "country": { "$ref": "#/definitions/MetadataValueCode" },
        "platformTemplateId": { "type": "string" },
        "defaultAssignee": { "$ref": "#/definitions/WorkflowAssigneeRef" },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 80,
          "items": { "$ref": "#/definitions/WorkflowTemplateStep" }
        }
      }
    },
    "MetadataValueCode": {
      "type": "string",
      "pattern": "^[A-Z0-9]+(_[A-Z0-9]+)*$",
      "description": "Metadata Registry metadataValueCode (e.g. CHRONIC). Options are served by metadata-registry-service POST /metadata/values/by-types; this service stores the code only."
    },
    "UpdateWorkflowTemplateRequest": {
      "type": "object",
      "required": ["templateName", "steps"],
      "additionalProperties": false,
      "properties": {
        "templateName": { "type": "string" },
        "description": { "type": "string" },
        "program": { "type": "string" },
        "condition": { "type": "string" },
        "basedOn": { "type": "string" },
        "category": { "$ref": "#/definitions/MetadataValueCode" },
        "shareScope": { "$ref": "#/definitions/MetadataValueCode" },
        "language": { "$ref": "#/definitions/MetadataValueCode" },
        "country": { "$ref": "#/definitions/MetadataValueCode" },
        "platformTemplateId": { "type": "string" },
        "defaultAssignee": { "$ref": "#/definitions/WorkflowAssigneeRef" },
        "recordVersion": {
          "type": "integer",
          "minimum": 1,
          "description": "OCC alternative to If-Match header"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 80,
          "items": { "$ref": "#/definitions/WorkflowTemplateStep" }
        }
      }
    },
    "PublishWorkflowTemplateRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "recordVersion": {
          "type": "integer",
          "minimum": 1,
