{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "The AWS CloudFormation template for this Serverless application",
  "Resources": {
    "WorkflowTable": {
      "Type": "AWS::DynamoDB::Table",
      "DeletionPolicy": "Retain",
      "UpdateReplacePolicy": "Retain",
      "Properties": {
        "TableName": "workflow-dev-db",
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "pk",
            "AttributeType": "S"
          },
          {
            "AttributeName": "sk",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "pk",
            "KeyType": "HASH"
          },
          {
            "AttributeName": "sk",
            "KeyType": "RANGE"
          }
        ],
        "StreamSpecification": {
          "StreamViewType": "NEW_AND_OLD_IMAGES"
        },
        "PointInTimeRecoverySpecification": {
          "PointInTimeRecoveryEnabled": true
        },
        "Tags": [
          {
            "Key": "Service",
            "Value": "workflow-service"
          },
          {
            "Key": "Stage",
            "Value": "dev"
          },
          {
            "Key": "Purpose",
            "Value": "WorkflowTable"
          },
          {
            "Key": "ManagedBy",
            "Value": "serverless"
          }
        ]
      }
    },
    "WorkflowTableNameParameter": {
      "Type": "AWS::SSM::Parameter",
      "Properties": {
        "Name": "/dev/workflow-service/TABLE_NAME",
        "Type": "String",
        "Description": "Workflow Service DynamoDB table name",
        "Value": {
          "Ref": "WorkflowTable"
        },
        "Tags": {
          "Service": "workflow-service",
          "Stage": "dev"
        }
      }
    },
    "WorkflowTableArnParameter": {
      "Type": "AWS::SSM::Parameter",
      "Properties": {
        "Name": "/dev/workflow-service/TABLE_ARN",
        "Type": "String",
        "Description": "Workflow Service DynamoDB table ARN",
        "Value": {
          "Fn::GetAtt": [
            "WorkflowTable",
            "Arn"
          ]
        },
        "Tags": {
          "Service": "workflow-service",
          "Stage": "dev"
        }
      }
    },
    "WorkflowTableStreamArnParameter": {
      "Type": "AWS::SSM::Parameter",
      "Properties": {
        "Name": "/dev/workflow-service/STREAM_ARN",
        "Type": "String",
        "Description": "Workflow Service DynamoDB stream ARN",
        "Value": {
          "Fn::GetAtt": [
            "WorkflowTable",
            "StreamArn"
          ]
        },
        "Tags": {
          "Service": "workflow-service",
          "Stage": "dev"
        }
      }
    }
  },
  "Outputs": {
    "ServerlessDeploymentBucketName": {
      "Value": "dev-workflow-service-bucket",
      "Export": {
        "Name": "sls-workflow-service-data-dev-ServerlessDeploymentBucketName"
      }
    }
  }
}