flowchart TD
    %% Triggers
    A([Developer Push / PR Merge]) --> B[GitHub Actions Runner]

    %% CI Stage
    subgraph CI["Stage 1: Continuous Integration (CI)"]
        B --> C[Checkout Code & Install Dependencies]
        C --> D[Run Linter & Type Check]
        D --> E[Run Unit & Integration Tests]
        E --> F[Security Scan: SAST & Secret Audit]
        F --> G[Build Container Image]
        G --> H[(Push Image to OCI Registry)]
    end

    %% Staging Deployment
    subgraph STAGING["Stage 2: Staging Deployment"]
        H --> I[Update GitOps Manifests: Staging]
        I --> J[ArgoCD / Deployment Controller Sync]
        J --> K[Run Smoke & Contract Tests]
    end

    %% Governance Gate
    K --> L{All Tests Passed?}
    L -- No --> M[Send Slack Alert & Halt]
    L -- Yes --> N{Production Manual Approval Gate}

    %% Production Deployment
    subgraph PROD["Stage 3: Production Release (Canary)"]
        N -- Rejected --> O[Cancel Deployment]
        N -- Approved --> P[Trigger Canary Deployment: 10% Traffic]
        P --> Q[Evaluate Metrics: Latency & Error Rate]
        Q --> R{Health Check OK?}
        R -- Unhealthy --> S[Automated Rollback to Previous Version]
        R -- Healthy --> T[Promote to 100% Traffic]
        T --> U([Notify Team: Deployment Successful])
    end

    classDef stage fill:#f8f9fa,stroke:#4a5568,stroke-width:1px;
    classDef gate fill:#fff3cd,stroke:#d69e2e,stroke-width:1px;
    classDef failure fill:#fed7d7,stroke:#e53e3e,stroke-width:1px;
    class CI,STAGING,PROD stage;
    class L,N,R gate;
    class M,O,S failure;