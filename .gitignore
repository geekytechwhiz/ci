# Dependency directories (never commit these)
node_modules/
jspm_packages/
web_modules/

# Environment variables and secrets
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Generated Serverless / CI packaging artifacts (not source-of-truth)
.serverless/
**/.serverless/
data/packaged.yaml
infra/packaged.yaml
app/packaged.yaml
**/data/packaged.yaml
**/infra/packaged.yaml
**/app/packaged.yaml

# Build outputs and caches
dist/
build/
.next/
.nuxt/
out/
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
*.tsbuildinfo

# Testing and coverage output
coverage/
*.lcov
.nyc_output

# Optional npm cache and REPL history
.npm
.node_repl_history

# Output of 'npm pack'
*.tgz

# OS files (Optional, but highly recommended)
.DS_Store
Thumbs.db
