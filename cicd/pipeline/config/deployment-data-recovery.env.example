# Example environment variables for Data recovery prepare/execute.
# Written by prepare-data-recovery.sh when DATA_ACTION=RECOVERY_REQUIRED.
# Consumed by execute-data-recovery.sh after manual approval.

STAGE=dev
SERVICE_NAME=example-service
AWS_REGION=us-east-1
ARTIFACT_BUCKET=dev-artifacts-bucket
CURRENT_COMMIT=abc1234deadbeef

DATA_STACK_NAME=dev-example-service-data
DATA_TABLE_NAME=example-service-dev
DATA_LOGICAL_ID=PrimaryTable

# Ownership (must match live table tags)
OWNERSHIP_TAG_SERVICE=example-service
OWNERSHIP_TAG_PURPOSE=primaryDataTable
OWNERSHIP_TAG_MANAGED_BY=serverless

# CloudFormation roles (optional but recommended)
# CFN_RECOVER_ROLE_ARN=arn:aws:iam::123456789012:role/dev-example-service-cfn-recover-data-role
# RECOVER_DATA_ROLE_ARN=arn:aws:iam::123456789012:role/dev-example-service-recover-data-role

# Hand-off files
DATA_PREFLIGHT_ENV=deployment-data-preflight.env
DATA_RECOVERY_ENV=deployment-data-recovery.env
DATA_RECOVERY_RESULT_ENV=deployment-data-recovery-result.env

# Phase: prepare (Deploy-Data) | execute (Recover-Data)
DATA_RECOVERY_PHASE=prepare

# Outputs written by prepare (approval-ready):
#   DATA_ACTION=RECOVERY_REQUIRED
#   RECOVERY_REQUIRED=true
#   RECOVERY_STATUS=APPROVAL_REQUIRED
#   CHANGE_SET_NAME=recovery-${SERVICE_NAME}-${STAGE}-${CURRENT_COMMIT}
#   RECOVERY_CHANGE_SET_NAME=...
#   RECOVERY_STACK_NAME=...
#   RECOVERY_TABLE_NAME=...
#   DATA_ARTIFACT_URI=s3://...

# Execute markers (set by Recover-Data / CodePipeline approval):
#   RECOVERY_STATUS=APPROVAL_GRANTED
#   RECOVERY_APPROVAL=GRANTED
#   CODEPIPELINE_APPROVAL_RESULT=Approved
