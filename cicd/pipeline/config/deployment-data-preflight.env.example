# Example environment variables for Data preflight (Deploy-Data).
# Copy / adapt into CodeBuild project env or a service-specific env file.
# Never hard-code service names in the framework scripts — set them here.

# Required identity
STAGE=dev
SERVICE_NAME=example-service
AWS_REGION=us-east-1
ARTIFACT_BUCKET=dev-artifacts-bucket
CURRENT_COMMIT=abc1234deadbeef

# Stack / table (defaults shown; override when needed)
# DATA_STACK_NAME=${STAGE}-${SERVICE_NAME}-data
DATA_TABLE_NAME=example-service-dev
DATA_LOGICAL_ID=PrimaryTable

# Ownership tags verified when stack is missing but table exists
OWNERSHIP_TAG_SERVICE=example-service
OWNERSHIP_TAG_PURPOSE=primaryDataTable
OWNERSHIP_TAG_MANAGED_BY=serverless

# Paths written by data-preflight.sh
DATA_PREFLIGHT_ENV=deployment-data-preflight.env

# Outputs (written by data-preflight.sh — do not set manually):
#   DATA_STACK_STATE=EXISTS|NOT_FOUND|UNKNOWN
#   DATA_STACK_STATUS=...
#   DATA_TABLE_STATE=EXISTS|NOT_FOUND|NOT_CHECKED|UNKNOWN
#   DATA_TABLE_OWNERSHIP=VERIFIED|UNVERIFIED|NOT_APPLICABLE
#   DATA_TABLE_CONFIGURATION=COMPATIBLE|INCOMPATIBLE|NOT_APPLICABLE
#   DATA_ACTION=CREATE|UPDATE|STOP|RECOVERY_REQUIRED
#   DATA_STOP_REASON=...
#   DATA_ARTIFACT_COMMIT=...
#   DATA_ARTIFACT_URI=...
